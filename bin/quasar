#!/usr/bin/env bash
# Quasar Standalone Launcher (Web App & macOS Desktop App) powered by Antigravity CLI (`agy`)
#
# Usage:
#   quasar                                    # Launch Quasar Web App (zero install) on http://127.0.0.1:49341
#   quasar https://github.com/org/repo/pull/1 # Start a PR review via `agy` CLI & open Quasar
#   quasar --branch [branch] [--repo <dir>]   # Start a local branch review via `agy` CLI & open Quasar
#   quasar --desktop                          # Launch native Flutter macOS Desktop App (`Quasar.app`)
#   quasar --tutorial                         # Open the interactive sandbox tutorial
#   quasar watch [--sync|--once|--stop|--status] # Manage background PR Inbox & Auto-Review daemon
#   quasar clean [--days N|--all]             # Prune old saved reviews & snapshots (default: >30 days)
#   quasar delete <review_id>                 # Permanently delete a specific saved review & its snapshots
set -euo pipefail

SCRIPT_PATH="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
SERVER_PY="${REPO_ROOT}/plugin/sidecars/quasar-web/server.py"
if [ ! -f "${SERVER_PY}" ]; then
  SERVER_PY="${REPO_ROOT}/sidecars/quasar-web/server.py"
fi
if [ ! -f "${SERVER_PY}" ]; then
  SERVER_PY="${HOME}/.gemini/config/plugins/quasar/sidecars/quasar-web/server.py"
fi

INBOX_WATCHER_PY="${REPO_ROOT}/plugin/skills/quasar/scripts/inbox_watcher.py"
if [ ! -f "${INBOX_WATCHER_PY}" ]; then
  INBOX_WATCHER_PY="${REPO_ROOT}/skills/quasar/scripts/inbox_watcher.py"
fi
if [ ! -f "${INBOX_WATCHER_PY}" ]; then
  INBOX_WATCHER_PY="${HOME}/.gemini/config/plugins/quasar/skills/quasar/scripts/inbox_watcher.py"
fi

if [ "${1:-}" = "watch" ] || [ "${1:-}" = "inbox" ]; then
  shift
  if [ $# -eq 0 ]; then
    exec python3 "${INBOX_WATCHER_PY}" --start-daemon
  fi
  WATCH_ARGS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --sync)
        WATCH_ARGS+=("--sync-now")
        shift
        ;;
      --once)
        WATCH_ARGS+=("--run-cycle")
        shift
        ;;
      --stop)
        WATCH_ARGS+=("--stop-daemon")
        shift
        ;;
      --status)
        WATCH_ARGS+=("--get-state")
        shift
        ;;
      *)
        WATCH_ARGS+=("$1")
        shift
        ;;
    esac
  done
  exec python3 "${INBOX_WATCHER_PY}" "${WATCH_ARGS[@]}"
fi

if [ "${1:-}" = "delete" ] || [ "${1:-}" = "rm" ]; then
  shift
  if [ $# -eq 0 ]; then
    echo "Usage: quasar delete <review_id>   (use 'quasar clean --list' to view saved review IDs)" >&2
    exit 1
  fi
  exec python3 "${INBOX_WATCHER_PY}" --delete-review "$1"
fi

if [ "${1:-}" = "clean" ] || [ "${1:-}" = "prune" ]; then
  shift
  if [ "${1:-}" = "--list" ]; then
    exec python3 "${INBOX_WATCHER_PY}" --list-reviews
  fi
  if [ "${1:-}" = "--all" ]; then
    exec python3 "${INBOX_WATCHER_PY}" --delete-all-reviews
  fi
  DAYS="30"
  if [ "${1:-}" = "--days" ] && [ -n "${2:-}" ]; then
    DAYS="$2"
  elif [[ "${1:-}" =~ ^[0-9]+$ ]]; then
    DAYS="$1"
  fi
  exec python3 "${INBOX_WATCHER_PY}" --prune-days "${DAYS}"
fi

PORT="${QUASAR_PORT:-49341}"
URL="http://127.0.0.1:${PORT}"
PR_URL=""
BRANCH_MODE=0
BRANCH_NAME=""
REPO_DIR="$(pwd)"
EFFORT="high"
COMMENTS_ONLY=0
DESKTOP_MODE=0
TUTORIAL_MODE=0
NO_OPEN=0
FORCE_NEW=0

while [ $# -gt 0 ]; do
  case "$1" in
    --desktop)
      DESKTOP_MODE=1
      shift
      ;;
    --tutorial)
      TUTORIAL_MODE=1
      shift
      ;;
    --branch)
      BRANCH_MODE=1
      if [ $# -ge 2 ] && [[ ! "$2" =~ ^-- ]]; then
        BRANCH_NAME="$2"
        shift 2
      else
        shift
      fi
      ;;
    --repo|--workspace-dir)
      REPO_DIR="$2"
      shift 2
      ;;
    --effort)
      EFFORT="$2"
      shift 2
      ;;
    --comments-only)
      COMMENTS_ONLY=1
      shift
      ;;
    --no-open)
      NO_OPEN=1
      shift
      ;;
    --force|--fresh)
      FORCE_NEW=1
      shift
      ;;
    -v|--version)
      PLUGIN_JSON="${REPO_ROOT}/plugin/plugin.json"
      if [ ! -f "${PLUGIN_JSON}" ]; then
        PLUGIN_JSON="${REPO_ROOT}/plugin.json"
      fi
      if [ ! -f "${PLUGIN_JSON}" ]; then
        PLUGIN_JSON="${HOME}/.gemini/config/plugins/quasar/plugin.json"
      fi
      if [ -f "${PLUGIN_JSON}" ]; then
        python3 -c 'import json, sys; print("quasar v" + json.load(open(sys.argv[1]))["version"])' "${PLUGIN_JSON}"
      else
        echo "quasar (standalone)"
      fi
      exit 0
      ;;
    -h|--help)
      sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      PR_URL="$1"
      shift
      ;;
  esac
done

ensure_server_running() {
  if curl -fsS "${URL}/api/state" >/dev/null 2>&1; then
    return 0
  fi
  echo "🚀 Starting Quasar local backend on ${URL}..."
  PORT="${PORT}" nohup python3 "${SERVER_PY}" --standalone-daemon >/tmp/quasar-standalone.log 2>&1 &
  for _ in $(seq 1 25); do
    if curl -fsS "${URL}/api/state" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.2
  done
  echo "⚠️  Quasar backend did not respond on ${URL}; check /tmp/quasar-standalone.log" >&2
  return 1
}

ensure_server_running

if [ "${TUTORIAL_MODE}" = "1" ]; then
  echo "🎓 Generating interactive sandbox tutorial..."
  curl -fsS -X POST "${URL}/api/tutorial" -H "Content-Type: application/json" -d '{}' >/dev/null
elif [ -n "${PR_URL}" ] || [ "${BRANCH_MODE}" = "1" ]; then
  echo "🔬 Checking & dispatching review..."
  CO_BOOL="false"
  if [ "${COMMENTS_ONLY}" = "1" ]; then CO_BOOL="true"; fi
  FORCE_BOOL="false"
  if [ "${FORCE_NEW}" = "1" ]; then FORCE_BOOL="true"; fi
  python3 - "${URL}" "${PR_URL}" "${REPO_DIR}" "${BRANCH_NAME}" "${EFFORT}" "${CO_BOOL}" "${FORCE_BOOL}" <<'PY'
import json, os, sys, urllib.request

url, pr_url, repo_dir, branch, effort, co_str, force_str = sys.argv[1:8]

def post_json(endpoint, data):
    req = urllib.request.Request(
        f"{url}{endpoint}",
        data=json.dumps(data).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=20) as resp:
        return json.loads(resp.read().decode("utf-8") or "{}")

payload = {
    "prUrl": pr_url,
    "repoDir": repo_dir,
    "branch": branch,
    "effort": effort,
    "commentsOnly": co_str == "true",
    "forceNew": force_str == "true",
}
res = post_json("/api/start-review", payload)
if res.get("existingReviewFound") and isinstance(res.get("existingReview"), dict):
    ex = res["existingReview"]
    up_to_date = ex.get("isUpToDate", True)
    c_sha = str(ex.get("cachedHeadSha") or "")[:7]
    l_sha = str(ex.get("liveHeadSha") or "")[:7]
    sha_info = f"up to date @ {c_sha}" if up_to_date else f"new commits pushed ({c_sha} -> {l_sha})"
    print(f"  ⚡ Completed review already exists for {ex.get('owner')}/{ex.get('repo')}#{ex.get('number')} — {ex.get('title')}")
    print(f"     ({ex.get('sourceLabel')} • {str(ex.get('effort', 'high')).upper()} effort • {ex.get('findingsCount', 0)} finding(s) • {sha_info})")
    choice = "o" if up_to_date else "u"
    try:
        if os.path.exists("/dev/tty"):
            with open("/dev/tty", "r", encoding="utf-8") as tty_in, open("/dev/tty", "w", encoding="utf-8") as tty_out:
                if up_to_date:
                    tty_out.write("  👉 [O]pen existing review (0s), [U]pdated review, or [C]lean new review? [O/u/c]: ")
                    tty_out.flush()
                    ans = tty_in.readline().strip().lower()
                    if ans in ("o", "open", "s", "switch"):
                        choice = "o"
                    elif ans in ("u", "update", "updated", "i", "inc"):
                        choice = "u"
                    elif ans in ("c", "clean", "n", "new"):
                        choice = "c"
                else:
                    tty_out.write("  👉 Stale hash detected — [U]pdated review or [C]lean new review? [U/c]: ")
                    tty_out.flush()
                    ans = tty_in.readline().strip().lower()
                    if ans in ("u", "update", "updated", "i", "inc"):
                        choice = "u"
                    elif ans in ("c", "clean", "n", "new"):
                        choice = "c"
    except Exception:
        pass
    if choice == "o" and up_to_date:
        act = post_json("/api/inbox-activate", {
            "itemId": ex.get("itemId") or "",
            "sessionPath": ex.get("sessionPath") or "",
            "workspaceDir": repo_dir,
        })
        print(f"  ⚡ Opened existing review in 0s (session: {act.get('sessionId')})")
        sys.exit(0)
    payload["forceNew"] = True
    if choice == "u":
        payload["incremental"] = True
        payload["incrementalFrom"] = ex.get("sessionPath") or ""
    res = post_json("/api/start-review", payload)

print("  ✅ Dispatched:", json.dumps(res))
PY
fi

if [ "${NO_OPEN}" = "1" ]; then
  echo "✅ Quasar ready at ${URL}"
  exit 0
fi

if [ "${DESKTOP_MODE}" = "1" ]; then
  MAC_APP="${REPO_ROOT}/app/build/macos/Build/Products/Release/quasar_app.app"
  if [ ! -d "${MAC_APP}" ]; then
    MAC_APP="${REPO_ROOT}/app/build/macos/Build/Products/Debug/quasar_app.app"
  fi
  if [ -d "${MAC_APP}" ]; then
    echo "🖥️  Opening native macOS Quasar app..."
    open "${MAC_APP}"
    exit 0
  else
    echo "ℹ️  Native macOS bundle not built yet; run 'cd ${REPO_ROOT}/app && flutter build macos' (opening Web App now)..."
  fi
fi

echo "🌐 Opening Quasar Web App at ${URL}..."
if [ -d "/Applications/Google Chrome.app" ]; then
  open -na "Google Chrome" --args "--app=${URL}" >/dev/null 2>&1 || open "${URL}"
else
  open "${URL}"
fi
